}

// =====================================================
// SETUP / LOOP
// =====================================================
void setup() {
  Serial.begin(115200);
  delay(1000);

  pinMode(STOP_SIGNAL_PIN, OUTPUT);
  digitalWrite(STOP_SIGNAL_PIN, LOW);

  pinMode(FRONT_PIN, OUTPUT);
  pinMode(BACK_PIN, OUTPUT);
  setFacingPins(false, false);

  STM32Serial.begin(STM32_BAUD, SERIAL_8N1, STM32_RX, STM32_TX);

  initCamera();
  connectWiFi();

  cameraServer.begin();

  commandServer.on("/", HTTP_GET, handleRoot);
  commandServer.on("/log", HTTP_GET, handleLogGet);
  commandServer.on("/command", HTTP_POST, handleCommandPost);
  commandServer.onNotFound([]() { sendJsonError(404, "Endpoint not found"); });
  commandServer.begin();

  // Camera chạy task riêng trên core 0
  xTaskCreatePinnedToCore(cameraTask, "camTask", 8192, NULL, 1, NULL, 0);

  Serial.println("Ready. Web monitor: http://" + WiFi.localIP().toString() + "/");
}

void loop() {
  commandServer.handleClient();

  // Mất tín hiệu từ laptop quá lâu -> tắt cả hai chân front/back
  if (facingActive && millis() - lastFacingMs > FACING_TIMEOUT_MS) {
    setFacingPins(false, false);
    Serial.println("[FACING] timeout -> both pins LOW");
  }
  delay(1);
}
