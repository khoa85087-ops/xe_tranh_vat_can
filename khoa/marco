/* pown: x mũ n với n bất kỳ >= 0. Là LỆNH (có vòng lặp), đứng riêng 1 dòng.
   kq nên là FW hoặc biến long, i là biến INT16S tạm */
#define pown(kq,x,n,i) \
	do { (kq) = 1; for ((i) = 0; (i) < (n); (i)++) (kq) *= (x); } while(0)
//  vd: pown(FW[204], 2.0, 10, i);         // 2 mũ 10 ra 1024
/* floordiv: chia lấy phần nguyên làm tròn xuống, giống a // b của Python: -17 // 5 ra -4. b = 0 thì ra 0.
   (Phép / của C cắt về 0: -17 / 5 ra -3, muốn như C thì viết thẳng a / b) */
#define floordiv(a,b)       ((b) != 0 ? (((long)(a) - mod(a,b)) / (b)) : 0)
//  vd: D[22] = floordiv(D[0], 5);         // 17 ra 3, -17 ra -4
/* mod: chia lấy dư, giống a % b của Python: -17 % 5 ra 3, kết quả cùng dấu với b. b = 0 thì ra 0.
   (Phép % của C cho -17 % 5 ra -2, muốn như C thì viết thẳng a % b) */
#define mod(a,b)            ((b) != 0 ? ((((long)(a) % (b)) + (b)) % (b)) : 0)
//  vd: D[23] = mod(D[0], 5);              // 17 ra 2, -17 ra 3 (dùng để quay vòng chỉ số, góc)

