/* arr_sum: kq phải là biến long (tổng nhiều số 16 bit dễ tràn) */
#define arr_sum(bd,n,kq,i) \
	do { (kq) = 0; for ((i) = 0; (i) < (n); (i)++) (kq) += D[(bd)+(i)]; } while(0)
//  vd: arr_sum(200, 10, s, i);            // s = D200 + D201 + ... + D209

/* arr_mean: trung bình, kq là số thực (FW), s là biến long dùng tạm. n <= 0 thì ra 0 */
#define arr_mean(bd,n,s,i,kq) \
	do { arr_sum(bd,n,s,i); (kq) = ((n) > 0) ? ((float)(s) / (n)) : 0; } while(0)
//  vd: arr_mean(200, 10, s, i, FW[300]);  // FW300 = trung bình 10 số từ D200

#define arr_max(bd,n,kq,i) \
	do { (kq) = D[(bd)]; for ((i) = 1; (i) < (n); (i)++) if (D[(bd)+(i)] > (kq)) (kq) = D[(bd)+(i)]; } while(0)
//  vd: arr_max(200, 10, D[2], i);         // D2 = số lớn nhất trong D200..D209

#define arr_min(bd,n,kq,i) \
	do { (kq) = D[(bd)]; for ((i) = 1; (i) < (n); (i)++) if (D[(bd)+(i)] < (kq)) (kq) = D[(bd)+(i)]; } while(0)
//  vd: arr_min(200, 10, D[3], i);         // D3 = số nhỏ nhất

/* arr_fill: như memset, điền cả vùng bằng 1 giá trị */
#define arr_fill(bd,n,v,i) \
	do { for ((i) = 0; (i) < (n); (i)++) D[(bd)+(i)] = (v); } while(0)
//  vd: arr_fill(200, 10, 0, i);           // xóa D200..D209 về 0

/* arr_copy: như memcpy, hai vùng không được chồng lên nhau */
#define arr_copy(nguon,dich,n,i) \
	do { for ((i) = 0; (i) < (n); (i)++) D[(dich)+(i)] = D[(nguon)+(i)]; } while(0)
//  vd: arr_copy(200, 220, 10, i);         // chép D200..D209 sang D220..D229


#define arr_push(bd,n,moi,i) \
	do { for ((i) = 0; (i) < (n) - 1; (i)++) D[(bd)+(i)] = D[(bd)+(i)+1]; D[(bd)+(n)-1] = (moi); } while(0)
//  vd: arr_push(200, 10, D[0], i);        // nhét D0 vào D209, D200 bị bỏ


#define arr_sort(bd,n,i,j,t) \
	do { \
		for ((i) = 1; (i) < (n); (i)++) { \
			(t) = D[(bd)+(i)]; \
			for ((j) = (i) - 1; (j) >= 0 && D[(bd)+(j)] > (t); (j)--) D[(bd)+(j)+1] = D[(bd)+(j)]; \
			D[(bd)+(j)+1] = (t); \
		} \
	} while(0)
//  vd: arr_sort(220, 10, i, j, t);        // sắp xếp D220..D229 tăng dần

/* ===== INTERP (NỘI SUY BẢNG TRA, NHƯ NUMPY.INTERP) ===== */
#define interp(x,bx,by,n,i,kq) \
	do { \
		if ((x) <= D[(bx)]) (kq) = D[(by)]; \
		else if ((x) >= D[(bx)+(n)-1]) (kq) = D[(by)+(n)-1]; \
		else { \
			for ((i) = 1; (x) > D[(bx)+(i)]; (i)++) {} \
			(kq) = D[(by)+(i)-1] + ((float)(x) - D[(bx)+(i)-1]) * ((float)D[(by)+(i)] - D[(by)+(i)-1]) \
			       / ((float)D[(bx)+(i)] - D[(bx)+(i)-1]); \
		} \
	} while(0)
//  vd: interp(D[1], 300, 310, 5, i, FW[400]);   // tra bảng 5 điểm (x: D300..D304, y: D310..D314), vào D1, ra FW400

