void DZ(PINT16S W,PBIT B)
{
	#define SysRegAddr_HD_D_HM_M   

	#define D W
	#define M B
    #define FD FW

/* =====================================================================
   QUY TẮC CHUNG
   - Số nguyên gán vào D, số thực gán vào FW, đúng/sai gán vào M
   - FW chiếm 2 thanh ghi, đặt cách nhau 2: FW[20], FW[22], FW[24]...
   - Kết quả > 32767 thì dùng long hoặc FW, nếu không sẽ tràn
   - Đừng truyền biểu thức có ++ -- vào macro
   - Dòng "VD" là ví dụ nằm trong comment, muốn chạy thì bỏ // đi
   ===================================================================== */

/* ===== HẰNG SỐ ===== */
#define PI_V      3.14159265
//  VD: FW[20] = PI_V * 2;                 // ra 6.283
#define E_V       2.71828183
//  VD: FW[22] = E_V;                      // số e = 2.718
#define SQRT2_V   1.41421356
//  VD: FW[24] = SQRT2_V;                  // căn 2 = 1.414
#define SQRT3_V   1.73205081
//  VD: FW[26] = SQRT3_V;                  // căn 3 = 1.732
#define LN2_V     0.69314718
//  VD: FW[28] = LN2_V;                    // ln(2) = 0.693
#define LN10_V    2.30258509
//  VD: FW[30] = LN10_V;                   // ln(10) = 2.303
#define DEG2RAD   0.01745329
//  VD: FW[32] = 90 * DEG2RAD;             // 90 độ ra 1.5708 rad
#define RAD2DEG   57.2957795
//  VD: FW[34] = 3.1416 * RAD2DEG;         // pi rad ra 180 độ

/* ===== SO SÁNH, GIỚI HẠN ===== */
#define MAX(a,b)            ((a) > (b) ? (a) : (b))
//  VD: D[10] = MAX(D[0], D[1]);           // lấy số lớn hơn của D0 và D1
#define MIN(a,b)            ((a) < (b) ? (a) : (b))
//  VD: D[11] = MIN(D[0], D[1]);           // lấy số nhỏ hơn của D0 và D1
#define MAX3(a,b,c)         MAX(MAX(a,b),c)
//  VD: D[12] = MAX3(D[0], D[1], D[2]);    // lớn nhất trong 3 số
#define MIN3(a,b,c)         MIN(MIN(a,b),c)
//  VD: D[13] = MIN3(D[0], D[1], D[2]);    // nhỏ nhất trong 3 số
#define MAX4(a,b,c,d)       MAX(MAX(a,b),MAX(c,d))
//  VD: D[14] = MAX4(D[0], D[1], D[2], D[3]);   // lớn nhất trong 4 số
#define MIN4(a,b,c,d)       MIN(MIN(a,b),MIN(c,d))
//  VD: D[15] = MIN4(D[0], D[1], D[2], D[3]);   // nhỏ nhất trong 4 số
#define TRUNG_VI3(a,b,c)    MAX(MIN(a,b),MIN(MAX(a,b),c))
//  VD: D[16] = TRUNG_VI3(D[0], D[1], D[2]);    // số ở giữa (5,9,7 ra 7), lọc nhiễu
#define KEP(x,lo,hi)        ((x) < (lo) ? (lo) : ((x) > (hi) ? (hi) : (x)))
//  VD: D[17] = KEP(D[0], 0, 100);         // D0=150 ra 100, D0=-5 ra 0
#define TRONG(x,lo,hi)      ((x) >= (lo) && (x) <= (hi))
//  VD: M[0] = TRONG(D[0], 10, 50);        // D0 nằm trong 10..50 thì M0 = 1
#define NGOAI(x,lo,hi)      ((x) < (lo) || (x) > (hi))
//  VD: M[1] = NGOAI(D[0], 10, 50);        // D0 nằm ngoài 10..50 thì M1 = 1
#define GAN_BANG(a,b,e)     (ABS((a) - (b)) <= (e))
//  VD: M[2] = GAN_BANG(D[0], D[1], 2);    // D0 và D1 chênh không quá 2 thì M2 = 1
#define LA_ZERO(x,e)        (ABS(x) <= (e))
//  VD: M[3] = LA_ZERO(D[0], 1);           // D0 nằm trong -1..1 thì M3 = 1
#define KHOANG_CACH(a,b)    ABS((a) - (b))
//  VD: D[18] = KHOANG_CACH(D[0], D[1]);   // khoảng cách giữa D0 và D1 (3 và 10 ra 7)

/* ===== SỐ HỌC CƠ BẢN ===== */
#define ABS(x)              ((x) < 0 ? -(x) : (x))
//  VD: D[20] = ABS(D[0]);                 // bỏ dấu âm (-5 ra 5)
#define SIGN(x)             ((x) > 0 ? 1 : ((x) < 0 ? -1 : 0))
//  VD: D[21] = SIGN(D[0]);                // dương ra 1, âm ra -1, bằng 0 ra 0
#define SQR(x)              ((x) * (x))
//  VD: D[22] = SQR(D[0]);                 // bình phương (4 ra 16)
#define CUBE(x)             ((x) * (x) * (x))
//  VD: D[23] = CUBE(D[0]);                // lập phương (3 ra 27)
#define TB2(a,b)            (((a) + (b)) / 2)
//  VD: D[24] = TB2(D[0], D[1]);           // trung bình 2 số (4 và 6 ra 5), số nguyên bị cắt lẻ
#define TB3(a,b,c)          (((a) + (b) + (c)) / 3)
//  VD: D[25] = TB3(D[0], D[1], D[2]);     // trung bình 3 số (3,6,9 ra 6)
#define TB4(a,b,c,d)        (((a) + (b) + (c) + (d)) / 4)
//  VD: D[26] = TB4(D[0], D[1], D[2], D[3]);    // trung bình 4 số
#define CHIA_AT(a,b)        ((b) != 0 ? (a) / (b) : 0)
//  VD: D[27] = CHIA_AT(D[0], D[1]);       // D0 chia D1, nếu D1 = 0 thì ra 0, không lỗi
#define DU_AT(a,b)          ((b) != 0 ? (a) % (b) : 0)
//  VD: D[28] = DU_AT(D[0], 7);            // số dư khi chia 7 (10 ra 3)
#define CHAN(x)             (((x) % 2) == 0)
//  VD: M[4] = CHAN(D[0]);                 // D0 là số chẵn thì M4 = 1
#define LE(x)               (((x) % 2) != 0)
//  VD: M[5] = LE(D[0]);                   // D0 là số lẻ thì M5 = 1
#define BOI_CUA(x,n)        (((x) % (n)) == 0)
//  VD: M[6] = BOI_CUA(D[0], 10);          // D0 chia hết cho 10 thì M6 = 1
#define PHAN_TRAM(x,tong)   ((tong) != 0 ? ((long)(x) * 100 / (tong)) : 0)
//  VD: D[29] = PHAN_TRAM(D[0], D[1]);     // D0 là bao nhiêu % của D1 (25 trên 200 ra 12), cắt lẻ
#define PHAN_TRAM_F(x,tong) ((tong) != 0 ? ((x) * 100.0 / (tong)) : 0)
//  VD: FW[40] = PHAN_TRAM_F(D[0], D[1]);  // như trên nhưng có số lẻ (25 trên 200 ra 12.5)
#define TANG_PT(cu,moi)     ((cu) != 0 ? (((moi) - (cu)) * 100.0 / (cu)) : 0)
//  VD: FW[42] = TANG_PT(D[0], D[1]);      // % tăng từ D0 lên D1 (100 lên 120 ra 20, 100 xuống 80 ra -20)

/* ===== LÀM TRÒN, CẮT ===== */
#define CAT_NGUYEN(x)       ((long)(x))
//  VD: D[30] = CAT_NGUYEN(FW[40]);        // bỏ phần lẻ (3.7 ra 3, -3.7 ra -3)
#define PHAN_LE(x)          ((x) - (long)(x))
//  VD: FW[44] = PHAN_LE(FW[40]);          // chỉ lấy phần lẻ (3.7 ra 0.7)
#define LAM_TRON(x)         ((x) >= 0 ? (long)((x) + 0.5) : (long)((x) - 0.5))
//  VD: D[31] = LAM_TRON(FW[40]);          // làm tròn gần nhất (3.7 ra 4, 3.2 ra 3)
#define FLOOR(x)            ((x) >= 0 ? (long)(x) : (((long)(x) == (x)) ? (long)(x) : (long)(x) - 1))
//  VD: D[32] = FLOOR(FW[40]);             // làm tròn xuống (3.7 ra 3, -3.2 ra -4)
#define CEIL(x)             ((x) >= 0 ? (((long)(x) == (x)) ? (long)(x) : (long)(x) + 1) : (long)(x))
//  VD: D[33] = CEIL(FW[40]);              // làm tròn lên (3.2 ra 4, -3.7 ra -3)
/* LAM_TRON_N: làm tròn đến bội số của n, vd LAM_TRON_N(123,5) = 125 */
#define LAM_TRON_N(x,n)     (LAM_TRON((x) / (float)(n)) * (n))
//  VD: D[34] = LAM_TRON_N(D[0], 5);       // làm tròn về bội số của 5 (123 ra 125)
/* LAM_TRON_SL: giữ d chữ số thập phân, d là 10, 100, 1000 (vd 100 = 2 chữ số) */
#define LAM_TRON_SL(x,d)    (LAM_TRON((x) * (d)) / (float)(d))
//  VD: FW[46] = LAM_TRON_SL(FW[40], 100); // giữ 2 chữ số lẻ (3.14159 ra 3.14)

/* ===== SCALE (ĐỔI GIÁ TRỊ CẢM BIẾN) ===== */
/* Nhớ: "x chạy từ (il..ih) đổi thành (ol..oh)", vào trước ra sau */
/* SCALE: không chặn. Nếu il = ih thì ra ol (không chia 0) */
#define SCALE(x,il,ih,ol,oh) \
	(((ih) != (il)) ? (((float)((x)-(il))) * ((oh)-(ol)) / ((ih)-(il)) + (ol)) : (ol))
//  VD: FW[50] = SCALE(D[0], 4000, 20000, 0, 100);       // 4-20mA ra 0..100%, vượt khoảng thì ra quá 100 hoặc âm
/* SCALE_KEP: như SCALE nhưng chặn trong ol..oh. Dùng được cả khi scale ngược (ol > oh) */
#define SCALE_KEP(x,il,ih,ol,oh) \
	KEP(SCALE(x,il,ih,ol,oh), MIN(ol,oh), MAX(ol,oh))
//  VD: FW[52] = SCALE_KEP(D[0], 4000, 20000, 0, 100);   // như trên nhưng bị chặn trong 0..100 (nên dùng cái này)
/* SCALE_D: như SCALE_KEP nhưng làm tròn ra số nguyên, gán thẳng vào D */
#define SCALE_D(x,il,ih,ol,oh) \
	LAM_TRON(SCALE_KEP(x,il,ih,ol,oh))
//  VD: D[35] = SCALE_D(D[1], 0, 4095, 0, 1000);         // analog 0..4095 ra số nguyên 0..1000
/* PT_KEP: x (lo..hi) -> 0..100, có chặn. Nhớ để lo khác hi */
#define PT_KEP(x,lo,hi)     KEP(((float)((x) - (lo)) * 100.0 / ((hi) - (lo))), 0.0, 100.0)
//  VD: FW[54] = PT_KEP(D[0], 4000, 20000);              // đổi nhanh ra phần trăm 0..100

/* ===== ĐỔI ĐƠN VỊ (kết quả là số thực, gán vào FW) ===== */
#define RAD(deg)            ((deg) * DEG2RAD)
//  VD: FW[60] = RAD(180);                 // 180 độ ra 3.1416 rad
#define DEG(rad)            ((rad) * RAD2DEG)
//  VD: FW[62] = DEG(1.5708);              // 1.5708 rad ra 90 độ
#define C2F(c)              ((c) * 1.8 + 32.0)
//  VD: FW[64] = C2F(100);                 // 100 độ C ra 212 độ F
#define F2C(f)              (((f) - 32.0) / 1.8)
//  VD: FW[66] = F2C(212);                 // 212 độ F ra 100 độ C
#define C2K(c)              ((c) + 273.15)
//  VD: FW[68] = C2K(0);                   // 0 độ C ra 273.15 K
#define K2C(k)              ((k) - 273.15)
//  VD: FW[70] = K2C(273.15);              // 273.15 K ra 0 độ C
#define BAR2PSI(b)          ((b) * 14.5038)
//  VD: FW[72] = BAR2PSI(10);              // 10 bar ra 145.04 psi
#define PSI2BAR(p)          ((p) / 14.5038)
//  VD: FW[74] = PSI2BAR(145.04);          // 145.04 psi ra 10 bar
#define BAR2KPA(b)          ((b) * 100.0)
//  VD: FW[76] = BAR2KPA(1);               // 1 bar ra 100 kPa
#define KPA2BAR(k)          ((k) / 100.0)
//  VD: FW[78] = KPA2BAR(100);             // 100 kPa ra 1 bar
#define BAR2MPA(b)          ((b) / 10.0)
//  VD: FW[80] = BAR2MPA(150);             // 150 bar ra 15 MPa
#define MM2INCH(m)          ((m) / 25.4)
//  VD: FW[82] = MM2INCH(25.4);            // 25.4 mm ra 1 inch
#define INCH2MM(i)          ((i) * 25.4)
//  VD: FW[84] = INCH2MM(1);               // 1 inch ra 25.4 mm
#define M2FT(m)             ((m) * 3.28084)
//  VD: FW[86] = M2FT(1);                  // 1 mét ra 3.28 feet
#define FT2M(f)             ((f) / 3.28084)
//  VD: FW[88] = FT2M(3.28084);            // 3.28 feet ra 1 mét
#define KG2LB(k)            ((k) * 2.20462)
//  VD: FW[90] = KG2LB(1);                 // 1 kg ra 2.2046 pound
#define LB2KG(l)            ((l) / 2.20462)
//  VD: FW[92] = LB2KG(2.20462);           // 2.2046 pound ra 1 kg
#define L2GAL(l)            ((l) * 0.264172)
//  VD: FW[94] = L2GAL(1);                 // 1 lít ra 0.264 gallon
#define GAL2L(g)            ((g) / 0.264172)
//  VD: FW[96] = GAL2L(1);                 // 1 gallon ra 3.785 lít
#define MS2KMH(v)           ((v) * 3.6)
//  VD: FW[98] = MS2KMH(10);               // 10 m/s ra 36 km/h
#define KMH2MS(v)           ((v) / 3.6)
//  VD: FW[100] = KMH2MS(36);              // 36 km/h ra 10 m/s
#define HP2KW(h)            ((h) * 0.7457)
//  VD: FW[102] = HP2KW(1);                // 1 mã lực ra 0.7457 kW
#define KW2HP(k)            ((k) / 0.7457)
//  VD: FW[104] = KW2HP(0.7457);           // 0.7457 kW ra 1 mã lực
#define RPM2RADS(n)         ((n) * 0.10471976)
//  VD: FW[106] = RPM2RADS(60);            // 60 vòng/phút ra 6.283 rad/s
#define RADS2RPM(w)         ((w) * 9.5492966)
//  VD: FW[108] = RADS2RPM(6.283);         // 6.283 rad/s ra 60 vòng/phút
#define RPM2HZ(n)           ((n) / 60.0)
//  VD: FW[110] = RPM2HZ(1500);            // 1500 vòng/phút ra 25 Hz
#define HZ2RPM(f)           ((f) * 60.0)
//  VD: FW[112] = HZ2RPM(25);              // 25 Hz ra 1500 vòng/phút

/* ===== TÍNH TRÊN MẢNG (D liên tiếp, bd = địa chỉ D đầu tiên, n = số phần tử) ===== */
/* Biến đếm i, j, t khai báo ở đầu hàm. Đừng truyền biểu thức có ++ -- vào macro */

/* MANG_TONG: kq phải là biến long (tổng nhiều số 16 bit dễ tràn) */
#define MANG_TONG(bd,n,kq,i) \
	do { (kq) = 0; for ((i) = 0; (i) < (n); (i)++) (kq) += D[(bd)+(i)]; } while(0)
//  VD: MANG_TONG(200, 10, s, i);          // s = D200 + D201 + ... + D209

/* MANG_TB: trung bình, kq là số thực (FW), s là biến long dùng tạm */
#define MANG_TB(bd,n,s,i,kq) \
	do { MANG_TONG(bd,n,s,i); (kq) = ((n) > 0) ? ((float)(s) / (n)) : 0; } while(0)
//  VD: MANG_TB(200, 10, s, i, FW[300]);   // FW300 = trung bình 10 số từ D200

#define MANG_MAX(bd,n,kq,i) \
	do { (kq) = D[(bd)]; for ((i) = 1; (i) < (n); (i)++) if (D[(bd)+(i)] > (kq)) (kq) = D[(bd)+(i)]; } while(0)
//  VD: MANG_MAX(200, 10, D[2], i);        // D2 = số lớn nhất trong D200..D209

#define MANG_MIN(bd,n,kq,i) \
	do { (kq) = D[(bd)]; for ((i) = 1; (i) < (n); (i)++) if (D[(bd)+(i)] < (kq)) (kq) = D[(bd)+(i)]; } while(0)
//  VD: MANG_MIN(200, 10, D[3], i);        // D3 = số nhỏ nhất

#define MANG_DIEN(bd,n,v,i) \
	do { for ((i) = 0; (i) < (n); (i)++) D[(bd)+(i)] = (v); } while(0)
//  VD: MANG_DIEN(200, 10, 0, i);          // xóa D200..D209 về 0

#define MANG_COPY(nguon,dich,n,i) \
	do { for ((i) = 0; (i) < (n); (i)++) D[(dich)+(i)] = D[(nguon)+(i)]; } while(0)
//  VD: MANG_COPY(200, 220, 10, i);        // chép D200..D209 sang D220..D229

/* MANG_DAY: đẩy mẫu mới vào cuối, mẫu cũ nhất bị đẩy ra (cửa sổ trượt) */
#define MANG_DAY(bd,n,moi,i) \
	do { for ((i) = 0; (i) < (n) - 1; (i)++) D[(bd)+(i)] = D[(bd)+(i)+1]; D[(bd)+(n)-1] = (moi); } while(0)
//  VD: MANG_DAY(200, 10, D[0], i);        // nhét D0 vào D209, D200 bị bỏ

/* MANG_SORT: sắp xếp tăng dần (nổi bọt), t là biến tạm */
#define MANG_SORT(bd,n,i,j,t) \
	do { for ((i) = 0; (i) < (n) - 1; (i)++) for ((j) = 0; (j) < (n) - 1 - (i); (j)++) \
		if (D[(bd)+(j)] > D[(bd)+(j)+1]) { (t) = D[(bd)+(j)]; D[(bd)+(j)] = D[(bd)+(j)+1]; D[(bd)+(j)+1] = (t); } } while(0)
//  VD: MANG_SORT(220, 10, i, j, t);       // sắp xếp D220..D229 tăng dần

/* ===== NỘI SUY BẢNG TRA ===== */
/* Bảng X nằm ở D[bx..], bảng Y nằm ở D[by..], n điểm. X PHẢI tăng dần, không trùng nhau.
   Ngoài đầu bảng thì lấy Y đầu, ngoài cuối bảng thì lấy Y cuối (tự chặn). kq là số thực */
#define NOI_SUY(x,bx,by,n,i,kq) \
	do { \
		if ((x) <= D[(bx)]) (kq) = D[(by)]; \
		else if ((x) >= D[(bx)+(n)-1]) (kq) = D[(by)+(n)-1]; \
		else { \
			for ((i) = 1; (i) < (n); (i)++) if ((x) <= D[(bx)+(i)]) break; \
			(kq) = D[(by)+(i)-1] + (float)((x) - D[(bx)+(i)-1]) * (D[(by)+(i)] - D[(by)+(i)-1]) \
			       / (D[(bx)+(i)] - D[(bx)+(i)-1]); \
		} \
	} while(0)
//  VD: NOI_SUY(D[1], 300, 310, 5, i, FD[400]);   // tra bảng 5 điểm,in d1, out FW400
/* ===== THỜI GIAN ===== */
#define MS2S(ms)            ((ms) / 1000.0)
//  VD: FW[120] = MS2S(1500);              // 1500 ms ra 1.5 giây
#define S2MS(s)             ((s) * 1000L)
//  VD: D[40] = S2MS(5);                   // 5 giây ra 5000 ms
#define S2PHUT(s)           ((s) / 60.0)
//  VD: FW[122] = S2PHUT(90);              // 90 giây ra 1.5 phút
#define PHUT2S(p)           ((p) * 60L)
//  VD: D[41] = PHUT2S(3);                 // 3 phút ra 180 giây
#define PHUT2GIO(p)         ((p) / 60.0)
//  VD: FW[124] = PHUT2GIO(90);            // 90 phút ra 1.5 giờ
#define GIO2PHUT(h)         ((h) * 60L)
//  VD: D[42] = GIO2PHUT(2);               // 2 giờ ra 120 phút
#define GIO2S(h)            ((h) * 3600L)
//  VD: D[43] = GIO2S(1);                  // 1 giờ ra 3600 giây (GIO2S(10) = 36000 sẽ tràn D)
#define NGAY2GIO(d)         ((d) * 24L)
//  VD: D[44] = NGAY2GIO(2);               // 2 ngày ra 48 giờ

/* ===== HÌNH HỌC, CÔNG THỨC (gán vào FW) ===== */
#define CHU_VI_TRON(r)          (2 * PI_V * (r))
//  VD: FW[130] = CHU_VI_TRON(1);          // chu vi tròn bán kính 1 ra 6.283
#define DT_TRON(r)              (PI_V * (r) * (r))
//  VD: FW[132] = DT_TRON(2);              // diện tích tròn bán kính 2 ra 12.566
#define DT_CHU_NHAT(a,b)        ((a) * (b))
//  VD: FW[134] = DT_CHU_NHAT(3, 4);       // diện tích chữ nhật 3x4 ra 12
#define CHU_VI_CHU_NHAT(a,b)    (2 * ((a) + (b)))
//  VD: FW[136] = CHU_VI_CHU_NHAT(3, 4);   // chu vi chữ nhật 3x4 ra 14
#define DT_TAM_GIAC(day,cao)    ((day) * (cao) / 2.0)
//  VD: FW[138] = DT_TAM_GIAC(6, 4);       // diện tích tam giác đáy 6 cao 4 ra 12
#define DT_HINH_THANG(a,b,h)    (((a) + (b)) * (h) / 2.0)
//  VD: FW[140] = DT_HINH_THANG(3, 5, 2);  // hình thang đáy 3 và 5, cao 2 ra 8
#define TT_CAU(r)               (4.0 / 3.0 * PI_V * (r) * (r) * (r))
//  VD: FW[142] = TT_CAU(1);               // thể tích cầu bán kính 1 ra 4.189
#define TT_TRU(r,h)             (PI_V * (r) * (r) * (h))
//  VD: FW[144] = TT_TRU(0.5, 2.0);        // thể tích bồn trụ bán kính 0.5 cao 2 ra 1.571
#define TT_HOP(a,b,c)           ((a) * (b) * (c))
//  VD: FW[146] = TT_HOP(2, 3, 4);         // thể tích hộp 2x3x4 ra 24
#define TT_NON(r,h)             (PI_V * (r) * (r) * (h) / 3.0)
