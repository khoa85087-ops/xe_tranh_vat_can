#define pow(x,n) \
	((n) == 0 ? 1L : (n) == 1 ? (0L + (x)) : (n) == 2 ? (0L + (x)) * (x) : \
	 (n) == 3 ? (0L + (x)) * (x) * (x) : (n) == 4 ? (0L + (x)) * (x) * (x) * (x) : 0L)
