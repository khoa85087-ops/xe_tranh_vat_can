/* ===== BIT / BYTE / WORD TRÊN SỐ NGUYÊN (không phải bit M) ===== */
/* Muốn bật/tắt bit M thì viết thẳng M[0] = 1; hoặc M[0] = 0; */
#define BIT_SET(x,n)        ((x) |= (1 << (n)))
//  VD: BIT_SET(D[0], 3);                  // bật bit 3 của D0 (0 thành 8). Đứng riêng 1 dòng
#define BIT_CLR(x,n)        ((x) &= ~(1 << (n)))
//  VD: BIT_CLR(D[0], 3);                  // tắt bit 3 của D0 (8 thành 0)
#define BIT_TGL(x,n)        ((x) ^= (1 << (n)))
//  VD: BIT_TGL(D[0], 3);                  // đảo bit 3 của D0 (đang bật thì tắt, đang tắt thì bật)
#define BIT_TST(x,n)        (((x) >> (n)) & 1)
//  VD: M[10] = BIT_TST(D[0], 3);          // đọc bit 3 của D0 ra M10 (D0=8 thì M10=1)
#define BIT_GHI(x,n,v)      ((v) ? BIT_SET(x,n) : BIT_CLR(x,n))
//  VD: BIT_GHI(D[0], 3, M[5]);            // bit 3 của D0 = giá trị M5
#define MASK(n)             ((1 << (n)) - 1)
//  VD: D[50] = MASK(4);                   // 4 bit 1 liên tiếp ra 15
#define LAY_BIT_TRUONG(x,vt,len)  (((x) >> (vt)) & MASK(len))
//  VD: D[51] = LAY_BIT_TRUONG(D[0], 4, 3);     // lấy 3 bit bắt đầu từ bit 4 của D0
#define LOW_BYTE(x)         ((x) & 0xFF)
//  VD: D[52] = LOW_BYTE(D[0]);            // byte thấp (0x1234 ra 0x34)
#define HIGH_BYTE(x)        (((x) >> 8) & 0xFF)
//  VD: D[53] = HIGH_BYTE(D[0]);           // byte cao (0x1234 ra 0x12)
#define GHEP_16(hi,lo)      ((((hi) & 0xFF) << 8) | ((lo) & 0xFF))
//  VD: D[54] = GHEP_16(0x12, 0x34);       // ghép 2 byte thành 0x1234
#define DOI_BYTE(x)         ((((x) & 0xFF) << 8) | (((x) >> 8) & 0xFF))
//  VD: D[55] = DOI_BYTE(D[0]);            // đảo byte cao và thấp (0x1234 ra 0x3412)
#define LOW_WORD(x)         ((x) & 0xFFFF)
//  VD: D[56] = LOW_WORD(s);               // s là biến long, lấy 16 bit thấp
#define HIGH_WORD(x)        (((x) >> 16) & 0xFFFF)
//  VD: D[57] = HIGH_WORD(s);              // s là biến long, lấy 16 bit cao (100000 ra 1)
#define GHEP_32(hi,lo)      ((((long)(hi)) << 16) | ((lo) & 0xFFFF))
//  VD: s = GHEP_32(D[57], D[56]);         // ghép 2 word thành số 32 bit (s là biến long)
#define SWAP(t,a,b)         do { t tmp_ = (a); (a) = (b); (b) = tmp_; } while(0)
//  VD: SWAP(int, D[0], D[1]);             // đổi chỗ D0 và D1. Đứng riêng 1 dòng
#define SWAP_XOR(a,b)       do { (a) ^= (b); (b) ^= (a); (a) ^= (b); } while(0)
//  VD: SWAP_XOR(D[0], D[1]);              // đổi chỗ bằng XOR, không dùng với cùng 1 biến
#define LA_LUY_THUA_2(x)    (((x) > 0) && (((x) & ((x) - 1)) == 0))
//  VD: M[11] = LA_LUY_THUA_2(D[0]);       // D0 là 1, 2, 4, 8, 16... thì M11 = 1

/* ===== BCD, GRAY ===== */
#define BCD2BIN(x)          ((((x) >> 4) & 0xF) * 10 + ((x) & 0xF))
//  VD: D[60] = BCD2BIN(0x25);             // BCD 0x25 ra số 25
#define BIN2BCD(x)          ((((x) / 10) << 4) | ((x) % 10))
//  VD: D[61] = BIN2BCD(25);               // số 25 ra BCD 0x25
#define BIN2GRAY(x)         ((x) ^ ((x) >> 1))
//  VD: D[62] = BIN2GRAY(5);               // nhị phân 5 ra mã Gray 7

