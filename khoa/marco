   Python thì làm tròn .5 về số chẵn (round(2.5) = 2), khác chỗ này */
#define round(x)            ((long)((x) + ((x) >= 0 ? 0.5 : -0.5)))
//  vd: D[31] = round(FW[40]);             // làm tròn gần nhất (3.7 ra 4, 3.2 ra 3, -3.5 ra -4)
#define floor(x)            ((long)(x) - ((x) < (long)(x)))
