#define round_n(x,k)        (round((x) * pow(10,k)) / (float)pow(10,k))
//  vd: FW[46] = round_n(FW[40], 2);       // giữ 2 chữ số lẻ (3.14159 ra 3.14)

/* ===== map đổi giá trị cảm biến*/

#define map_range(x,il,ih,ol,oh) \
	(((ih) != (il)) ? (((float)(x) - (il)) * ((float)(oh) - (ol)) / ((float)(ih) - (il)) + (ol)) : (ol))
//  vd: FW[50] = map_range(D[0], 4000, 20000, 0, 100);   // 4-20ma ra 0..100%, vượt khoảng thì ra quá 100 hoặc âm
#define map_clamp(x,il,ih,ol,oh) \
	map_range(limit(x, min(il,ih), max(il,ih)), il, ih, ol, oh)
//  vd: FW[52] = map_clamp(D[0], 4000, 20000, 0, 100);   // như trên nhưng bị chặn trong 0..100 (nên dùng cái này)
#define map_int(x,il,ih,ol,oh) \
	round(map_clamp(x,il,ih,ol,oh))
//  vd: D[35] = map_int(D[1], 0, 4095, 0, 1000);         // analog 0..4095 ra số nguyên 0..1000
