
#include <stdint.h>

#define SLAVE_ID 1

#define BTN2 2
#define BTN3 3
#define BTN4 4

// Mang chuan Modbus RTU
uint8_t ghiD100[8] = {0x01, 0x06, 0x00, 0x64, 0x00, 0x64, 0xC9, 0xFE};
uint8_t docD120[8] = {0x01, 0x03, 0x00, 0x78, 0x00, 0x01, 0x04, 0x13};

// Tinh CRC16 Modbus
uint16_t crc16(uint8_t *buf, uint8_t len) {
  uint16_t crc = 0xFFFF;

  for (uint8_t i = 0; i < len; i++) {
    crc ^= buf[i];
    for (uint8_t j = 0; j < 8; j++)
      crc = (crc & 1) ? (crc >> 1) ^ 0xA001 : crc >> 1;
  }

  return crc;
}

// Cap nhat CRC
void datCRC(uint8_t *m) {
  uint16_t crc = crc16(m, 6);
  m[6] = crc & 0xFF;
  m[7] = crc >> 8;
}

// Gui khung va nhan phan hoi
uint8_t guiNhan(uint8_t *tx, uint8_t *rx, uint8_t soByte) {
  while (Serial.available()) Serial.read();

  Serial.write(tx, 8);
  Serial.flush();

  uint8_t n = 0;
  unsigned long t = millis();

  while (millis() - t < 500 && n < soByte) {
    if (Serial.available()) {
      rx[n++] = Serial.read();
      t = millis();
    }
  }

  return n;
}

// Ghi thanh ghi
bool ghi(uint16_t diaChi, uint16_t giaTri) {
  uint8_t rx[8];

  ghiD100[2] = diaChi >> 8;
  ghiD100[3] = diaChi & 0xFF;
  ghiD100[4] = giaTri >> 8;
  ghiD100[5] = giaTri & 0xFF;

  datCRC(ghiD100);

  return guiNhan(ghiD100, rx, 8) == 8;
}

// Doc thanh ghi
uint16_t doc(uint16_t diaChi) {
  uint8_t rx[8];

  docD120[2] = diaChi >> 8;
  docD120[3] = diaChi & 0xFF;

  datCRC(docD120);

  if (guiNhan(docD120, rx, 7) != 7) return 0xFFFF;

  return ((uint16_t)rx[3] << 8) | rx[4];
}

// Nhay LED 5 lan
void nhayLED() {
  for (uint8_t i = 0; i < 5; i++) {
    digitalWrite(LED_BUILTIN, HIGH);
    delay(200);
    digitalWrite(LED_BUILTIN, LOW);
    delay(200);
  }
}

void setup() {
  pinMode(BTN2, INPUT_PULLUP);
  pinMode(BTN3, INPUT_PULLUP);
  pinMode(BTN4, INPUT_PULLUP);
  pinMode(LED_BUILTIN, OUTPUT);

  Serial.begin(9600);
}

void loop() {
  // Nhan nut 2: ghi 100 vao D100
  if (digitalRead(BTN2) == LOW) {
    ghi(100, 100);
    while (digitalRead(BTN2) == LOW);
    delay(30);
  }

  // Nhan nut 3: ghi 100 vao D110
  if (digitalRead(BTN3) == LOW) {
    ghi(110, 100);
    while (digitalRead(BTN3) == LOW);
    delay(30);
  }

  // Nhan nut 4: doc D120 lien tuc
  if (digitalRead(BTN4) == LOW) {
    uint16_t x = doc(120);

    if (x == 100) {
      nhayLED();
    }

    while (digitalRead(BTN4) == LOW);
    delay(30);
  }
}
