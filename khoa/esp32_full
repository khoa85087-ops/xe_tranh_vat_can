    long v = readD(120);      // đọc D120 (lỗi trả -1)
    writeD(100, 500);         // ghi D100 = 500
    int  m = readM(300);      // đọc M300 (lỗi trả -1)
    writeM(400, true);        // bật M400

  NÚT NHẤN (ngắt, tất cả chân IN: 7, 8, 14, 38, 39, 40, 41):
    if (pressed(39)) { ... }  // nhấn nút GPIO39 thì làm gì đó (mỗi lần nhấn chạy 1 lần)

