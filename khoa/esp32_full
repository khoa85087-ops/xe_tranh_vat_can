// ======================= MODBUS RTU (copy nguyên phần này sang dự án khác) =======================
enum { MB_OK = 0, MB_NO_REPLY, MB_BAD_FRAME, MB_BAD_CRC, MB_EXCEPTION };
uint8_t mbException = 0;   // mã exception PLC trả về khi lỗi MB_EXCEPTION

const char* mbErrStr(int e) {
  switch (e) {
    case MB_NO_REPLY:  return "Khong co phan hoi (sai baud/parity/ID/day A-B?)";
    case MB_BAD_FRAME: return "Loi: phan hoi thieu byte";
    case MB_BAD_CRC:   return "Loi: sai CRC";
    case MB_EXCEPTION: return "PLC bao loi (exception)";
    default:           return "OK";
  }
}

uint16_t crc16(const uint8_t* buf, size_t len) {
  uint16_t crc = 0xFFFF;
  for (size_t i = 0; i < len; i++) {
    crc ^= buf[i];
    for (uint8_t j = 0; j < 8; j++) crc = (crc & 1) ? (crc >> 1) ^ 0xA001 : crc >> 1;
  }
  return crc;
}

String hexStr(const uint8_t* b, size_t n) {
  String s; char t[4];
  for (size_t i = 0; i < n; i++) { snprintf(t, sizeof(t), "%02X ", b[i]); s += t; }
  s.trim();
  return s;
}

// Gửi 1 khung rồi gom phản hồi
size_t mbTransact(HardwareSerial& p, const uint8_t* tx, size_t txLen, uint8_t* rx, size_t rxMax) {
  while (p.available()) p.read();
  p.write(tx, txLen);
  p.flush();
  size_t n = 0;
  unsigned long t = millis();
  while (millis() - t < MB_FIRST_TO && n == 0)
    if (p.available()) { rx[n++] = p.read(); t = millis(); }
  while (n > 0 && millis() - t < MB_GAP_TO && n < rxMax)
    if (p.available()) { rx[n++] = p.read(); t = millis(); }
  return n;
}

// Hàm lõi: dựng khung 8 byte (ID, fn, addr, val, CRC), gửi, kiểm tra CRC + exception
int mbExchange(int port, uint8_t fn, uint16_t addr, uint16_t val, uint8_t* rx, size_t& n, String* log = nullptr) {
  uint8_t tx[8] = {SLAVE_ID, fn, (uint8_t)(addr >> 8), (uint8_t)addr, (uint8_t)(val >> 8), (uint8_t)val};
  uint16_t c = crc16(tx, 6);
  tx[6] = c & 0xFF; tx[7] = c >> 8;
  if (log) *log += "TX: " + hexStr(tx, 8) + "\n";
  n = mbTransact(*ports[port], tx, 8, rx, MB_RX_MAX);
  if (n == 0) return MB_NO_REPLY;
  if (log) *log += "RX: " + hexStr(rx, n) + "\n";
  if (n < 5) return MB_BAD_FRAME;
  if (crc16(rx, n - 2) != (uint16_t)(rx[n - 2] | (rx[n - 1] << 8))) return MB_BAD_CRC;
  if (rx[1] & 0x80) { mbException = rx[2]; return MB_EXCEPTION; }
  return MB_OK;
}

// Đọc count thanh ghi D (lệnh 03) -> out[count]
int mbReadD(int port, uint16_t d, uint16_t count, uint16_t* out, String* log = nullptr) {
  uint8_t rx[MB_RX_MAX]; size_t n;
  int e = mbExchange(port, 0x03, d + D_OFFSET, count, rx, n, log);
  if (e) return e;
  if (n < 5u + count * 2) return MB_BAD_FRAME;
  for (uint16_t i = 0; i < count; i++) out[i] = (rx[3 + i * 2] << 8) | rx[4 + i * 2];
  return MB_OK;
}

// Ghi 1 thanh ghi D (lệnh 06)
int mbWriteD(int port, uint16_t d, uint16_t val, String* log = nullptr) {
  uint8_t rx[MB_RX_MAX]; size_t n;
  int e = mbExchange(port, 0x06, d + D_OFFSET, val, rx, n, log);
  return e ? e : (n >= 8 ? MB_OK : MB_BAD_FRAME);
}

// Đọc count bit M (lệnh 01) -> out[i] = 0/1
int mbReadM(int port, uint16_t m, uint16_t count, uint8_t* out, String* log = nullptr) {
  uint8_t rx[MB_RX_MAX]; size_t n;
  int e = mbExchange(port, 0x01, m, count, rx, n, log);
  if (e) return e;
  if (n < 5u + (count + 7) / 8) return MB_BAD_FRAME;
  for (uint16_t i = 0; i < count; i++) out[i] = (rx[3 + i / 8] >> (i % 8)) & 1;
  return MB_OK;
}

// Ghi 1 bit M (lệnh 05)
int mbWriteM(int port, uint16_t m, bool on, String* log = nullptr) {
  uint8_t rx[MB_RX_MAX]; size_t n;
  int e = mbExchange(port, 0x05, m, on ? 0xFF00 : 0x0000, rx, n, log);
  return e ? e : (n >= 8 ? MB_OK : MB_BAD_FRAME);
}

// ---- 4 hàm dùng nhanh (cổng PLC_PORT) ----
long readD(uint16_t d)              { uint16_t v; return mbReadD(PLC_PORT, d, 1, &v) == MB_OK ? v : -1; }
bool writeD(uint16_t d, uint16_t v) { return mbWriteD(PLC_PORT, d, v) == MB_OK; }
int  readM(uint16_t m)              { uint8_t b; return mbReadM(PLC_PORT, m, 1, &b) == MB_OK ? b : -1; }
bool writeM(uint16_t m, bool on)    { return mbWriteM(PLC_PORT, m, on) == MB_OK; }

// Phân tích lệnh gõ tay: d100,100 | d120 | d120:5 | m400,1 | m300 | m300:8
// true = là lệnh Modbus (kết quả nằm trong log)
bool modbusCommand(int port, String s, String& log) {
  s.trim(); s.toLowerCase();
  if (s.length() < 2 || (s[0] != 'd' && s[0] != 'm') || !isDigit(s[1])) return false;

  bool isM = (s[0] == 'm');
  char tag = isM ? 'M' : 'D';
  int comma = s.indexOf(','), colon = s.indexOf(':');
  int e;

  if (comma > 0) {                                   // ----- GHI -----
    uint16_t addr = s.substring(1, comma).toInt();
    long v = s.substring(comma + 1).toInt();
    e = isM ? mbWriteM(port, addr, v != 0, &log) : mbWriteD(port, addr, (uint16_t)v, &log);
    if (e == MB_OK) log += String("OK: ") + tag + addr + " = " + (isM ? (v != 0) : v) + "\n";
  } else {                                           // ----- ĐỌC -----
    uint16_t addr = s.substring(1, colon > 0 ? colon : s.length()).toInt();
    int count = colon > 0 ? s.substring(colon + 1).toInt() : 1;
    int maxN = isM ? 64 : 20;
    if (count < 1 || count > maxN) { log = "Loi: so luong 1.." + String(maxN) + "\n"; return true; }
    if (isM) {
      uint8_t b[64];
      e = mbReadM(port, addr, count, b, &log);
      if (e == MB_OK) for (int i = 0; i < count; i++) log += "M" + String(addr + i) + " = " + String(b[i]) + "\n";
    } else {
      uint16_t v[20];
      e = mbReadD(port, addr, count, v, &log);
      if (e == MB_OK) for (int i = 0; i < count; i++) log += "D" + String(addr + i) + " = " + String(v[i]) + "\n";
    }
  }
  if (e != MB_OK) {
    log += mbErrStr(e);
    if (e == MB_EXCEPTION) log += " = " + String(mbException);
    log += "\n";
  }
  return true;
}

// ======================= RS485 =======================
void rs485Send(int idx, const String& msg) {
  String log;
  if (modbusCommand(idx, msg, log)) {
    txCount[idx] += 8;
    appendLog(idx, log);
    Serial.printf("[RS485-%d] MODBUS:\n%s", idx + 1, log.c_str());
    return;
  }
  ports[idx]->print(msg);                            // text thường
  ports[idx]->flush();
  txCount[idx] += msg.length();
  Serial.printf("[RS485-%d] TX: %s\n", idx + 1, msg.c_str());
}

void rs485Begin(int idx) {
  ports[idx]->end();
  ports[idx]->begin(rsBaud[idx], MB_SERIAL_CFG, RX_PIN[idx], TX_PIN[idx]);
}

// ======================= HANDLER WEB =======================
void handleRoot() { server.send_P(200, "text/html", PAGE); }

// /set?pin=9&state=1
void handleSet() {
  if (!server.hasArg("pin") || !server.hasArg("state")) return reply(400, "Thieu tham so pin/state");
  int pin = server.arg("pin").toInt();
  int state = server.arg("state").toInt();
  if (!isOutPin(pin)) return reply(400, "Chan khong thuoc nhom OUT");
  setOut(pin, state != 0);
  Serial.printf("Web: GPIO%d = %d\n", pin, state ? 1 : 0);
  reply(200, "OK");
}

// /plc?t=d&addr=100            -> đọc D100
// /plc?t=m&addr=400&val=1      -> ghi M400 = 1
void handlePlc() {
  bool isM = server.arg("t") == "m";
  int a = server.arg("addr").toInt();
  long v = server.arg("val").toInt();
  String name = String(isM ? "M" : "D") + a;
  long x;
  if (server.hasArg("val")) x = (isM ? writeM(a, v != 0) : writeD(a, v)) ? v : -1;
  else                      x = isM ? readM(a) : readD(a);
  reply(200, x < 0 ? name + ": LOI" : name + " = " + x);
}

// /rs485/send?port=1&data=d100,100
void handleRsSend() {
  int port = server.arg("port").toInt();
  if (port < 1 || port > NUM_PORTS) return reply(400, "Cong khong hop le (1..2)");
  rs485Send(port - 1, server.arg("data"));
  reply(200, "OK");
}

// /rs485/baud?port=1&baud=115200
void handleRsBaud() {
  int port = server.arg("port").toInt();
  long baud = server.arg("baud").toInt();
  if (port < 1 || port > NUM_PORTS || baud < 1200 || baud > 921600)
    return reply(400, "Cong (1..2) hoac baud (1200..921600) khong hop le");
  rsBaud[port - 1] = baud;
  rs485Begin(port - 1);
  Serial.printf("RS485-%d: baud = %ld\n", port, baud);
  reply(200, "Da dat baud " + String(baud) + " cho cong " + String(port));
}

// /rs485/clear?port=1
void handleRsClear() {
  int port = server.arg("port").toInt();
  if (port >= 1 && port <= NUM_PORTS) rxLog[port - 1] = "";
  reply(200, "OK");
}

// /status -> JSON
void handleStatus() {
  String j;
  j.reserve(2500);
  j += "{\"up\":" + String(millis() / 1000);
  j += ",\"rssi\":" + String(WiFi.RSSI());
  j += ",\"time\":\"" + timeStr() + "\"";
  j += ",\"epoch\":" + String((unsigned long)time(nullptr));
  j += ",\"temp\":" + String(temperatureRead(), 1);
  j += ",\"cpu\":" + String(getCpuFrequencyMhz());
  j += ",\"heap\":" + String(ESP.getFreeHeap());
  j += ",\"psram\":" + String(ESP.getFreePsram());
  j += ",\"flash\":" + String(ESP.getFlashChipSize() / 1048576);
  j += ",\"adc\":[";
  for (int i = 0; i < NUM_ADC; i++)
    j += String(i ? "," : "") + "{\"p\":" + ADC_PINS[i] + ",\"mv\":" + analogReadMilliVolts(ADC_PINS[i]) + "}";
  j += "],\"in\":[";
  for (int i = 0; i < NUM_IN; i++)
    j += String(i ? "," : "") + "{\"p\":" + IN_PINS[i] + ",\"v\":" + digitalRead(IN_PINS[i]) + "}";
  j += "],\"out\":[";
  for (int i = 0; i < NUM_OUT; i++)
    j += String(i ? "," : "") + "{\"p\":" + OUT_PINS[i] + ",\"v\":" + (outLvl[i] ? 1 : 0) + "}";
  j += "],\"rs\":[";
  for (int i = 0; i < NUM_PORTS; i++) {
    j += String(i ? "," : "") + "{\"tx\":" + TX_PIN[i] + ",\"rx\":" + RX_PIN[i] + ",\"baud\":" + rsBaud[i];
    j += ",\"rxn\":" + String(rxCount[i]) + ",\"txn\":" + String(txCount[i]);
    j += ",\"log\":\"" + jsonEscape(rxLog[i]) + "\"}";
  }
  j += "]}";
  reply(200, j, "application/json");
}

// ======================= WIFI / OTA =======================
void connectWiFi(unsigned long timeoutMs) {
  Serial.printf("Dang ket noi WiFi \"%s\"", WIFI_SSID);
  WiFi.mode(WIFI_STA);
  WiFi.setAutoReconnect(true);
  WiFi.begin(WIFI_SSID, WIFI_PASS);
  unsigned long start = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - start < timeoutMs) { delay(500); Serial.print("."); }
  if (WiFi.status() == WL_CONNECTED) {
    wifiWasConnected = true;
    Serial.print("\nWiFi OK! http://");
    Serial.println(WiFi.localIP());
  } else {
    Serial.println("\nChua ket noi duoc WiFi (se tu thu lai). Kiem tra ten/mat khau, song 2.4GHz.");
  }
}

void startOTA() {
  ArduinoOTA.setHostname(OTA_HOST);
  ArduinoOTA.setPassword(OTA_PASS);
  ArduinoOTA.onStart([]() { otaBusy = true;  Serial.println("OTA: bat dau nap..."); });
  ArduinoOTA.onEnd([]()   { otaBusy = false; Serial.println("OTA: xong, khoi dong lai"); });
  ArduinoOTA.onError([](ota_error_t e) { otaBusy = false; Serial.printf("OTA loi: %u\n", e); });
  ArduinoOTA.begin();
  otaStarted = true;
  Serial.printf("OTA san sang: %s (%s)\n", OTA_HOST, WiFi.localIP().toString().c_str());
}

// ======================= LỆNH SERIAL (UART0) =======================
void handleSerialCmd() {
  if (!Serial.available()) return;
  String line = Serial.readStringUntil('\n');
  line.trim();
  if (line.length() == 0) return;

  if (line.equalsIgnoreCase("info")) {
    Serial.printf("WiFi: %s  IP: %s  RSSI: %d dBm  Gio: %s\n",
                  WiFi.status() == WL_CONNECTED ? "OK" : "chua ket noi",
                  WiFi.localIP().toString().c_str(), WiFi.RSSI(), timeStr().c_str());
    Serial.printf("PLC: %s  D300=%u\n", plcOk ? "OK" : "mat ket noi", d300);
    return;
  }
  if (line.length() >= 2 && line.charAt(1) == ':') {          // "1:d100,100" | "1:m400,1" | "1:hello"
    int port = line.substring(0, 1).toInt();
    if (port >= 1 && port <= NUM_PORTS) rs485Send(port - 1, line.substring(2));
    else Serial.println("Loi: cong RS485 chi tu 1 den 2");
    return;
  }
  int comma = line.indexOf(',');                               // "9,1" -> bật/tắt chân OUT
  if (comma > 0) {
    int pin = line.substring(0, comma).toInt();
    int state = line.substring(comma + 1).toInt();
    if (isOutPin(pin)) { setOut(pin, state != 0); Serial.printf("OK: GPIO%d = %d\n", pin, state ? 1 : 0); }
    else Serial.printf("Loi: GPIO%d khong thuoc nhom OUT\n", pin);
    return;
  }
  Serial.println("Lenh khong hop le. Vi du: 1:hello | 1:d100,100 | 1:m400,1 | 9,1 | info");
}

// ======================= TÁC VỤ =======================
void rxTask() {
  for (int i = 0; i < NUM_PORTS; i++) {
    if (!ports[i]->available()) continue;
    String chunk;
    while (ports[i]->available()) chunk += (char)ports[i]->read();
    rxCount[i] += chunk.length();
    appendLog(i, chunk);
    Serial.printf("[RS485-%d] RX: %s\n", i + 1, chunk.c_str());
  }
}

void wifiTask() {
  if (WiFi.status() != WL_CONNECTED) {
    if (millis() - lastWifiTry > 15000) {
      lastWifiTry = millis();
      Serial.println("WiFi mat ket noi, dang thu lai...");
      WiFi.reconnect();
    }
  } else if (!wifiWasConnected) {
    wifiWasConnected = true;
    Serial.print("WiFi OK! http://");
    Serial.println(WiFi.localIP());
  }
}
