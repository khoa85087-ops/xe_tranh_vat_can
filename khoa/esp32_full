               {39, false, 0}, {40, false, 0}, {41, false, 0}};

void IRAM_ATTR isrBtn(void* arg) {
  Btn* b = (Btn*)arg;
  unsigned long n = millis();
  if (n - b->t > 50) { b->flag = true; b->t = n; }   // chống rung 50ms
}

// pressed(39) = nút GPIO39 vừa được nhấn (mỗi lần nhấn chỉ trả true một lần)
bool pressed(int pin) {
  for (auto &b : btns)
    if (b.pin == pin && b.flag) { b.flag = false; return true; }
  return false;
}

