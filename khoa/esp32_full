// ======================= SETUP / LOOP =======================
void setup() {
  Serial.begin(115200);
  delay(2000);
  Serial.println("\n===== ESP32-S3 FULL =====");

  for (int i = 0; i < NUM_IN; i++) pinMode(IN_PINS[i], INPUT_PULLUP);
  for (int i = 0; i < NUM_OUT; i++) { pinMode(OUT_PINS[i], OUTPUT); setOut(OUT_PINS[i], false); }
  for (auto &b : btns)
    attachInterruptArg(digitalPinToInterrupt(b.pin), isrBtn, &b, FALLING);

  analogReadResolution(12);
  analogSetAttenuation(ADC_11db);
  for (int i = 0; i < NUM_ADC; i++) pinMode(ADC_PINS[i], INPUT);

  for (int i = 0; i < NUM_PORTS; i++) {
    ports[i]->begin(rsBaud[i], MB_SERIAL_CFG, RX_PIN[i], TX_PIN[i]);
    Serial.printf("RS485-%d: UART%d TX=%d RX=%d @%lu\n", i + 1, i + 1, TX_PIN[i], RX_PIN[i], rsBaud[i]);
  }

  connectWiFi(20000);

  startNtp();
  struct tm ti;
  if (getLocalTime(&ti, 5000)) Serial.println("Da dong bo gio: " + timeStr());
  else Serial.println("Chua lay duoc gio (se tu thu lai)");

  server.on("/", handleRoot);
  server.on("/set", handleSet);
  server.on("/status", handleStatus);
  server.on("/plc", handlePlc);
  server.on("/rs485/send", handleRsSend);
  server.on("/rs485/baud", handleRsBaud);
  server.on("/rs485/clear", handleRsClear);
  server.begin();
  Serial.println("Web server da chay. Go lenh: 1:hello | 1:d100,100 | 1:m400,1 | 9,1 | info");
}

