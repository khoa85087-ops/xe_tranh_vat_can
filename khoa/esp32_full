// /set?pin=9&state=1
void handleSet() {
  if (!server.hasArg("pin") || !server.hasArg("state")) {
    server.send(400, "text/plain", "Thieu tham so pin/state");
    return;
  }
  int pin = server.arg("pin").toInt();
  int state = server.arg("state").toInt();
  if (!isOutPin(pin)) {
    server.send(400, "text/plain", "Chan khong thuoc nhom OUT");
    return;
  }
  digitalWrite(pin, state ? HIGH : LOW);
  Serial.printf("Web: GPIO%d = %d\n", pin, state ? 1 : 0);
  server.send(200, "text/plain", "OK");
}

// /rs485/send?port=1&data=d100,100
void handleRsSend() {
  int port = server.arg("port").toInt();
  if (port < 1 || port > NUM_PORTS) {
    server.send(400, "text/plain", "Cong khong hop le (1..2)");
    return;
  }
  rs485Send(port - 1, server.arg("data"));
  server.send(200, "text/plain", "OK");
}

// /rs485/baud?port=1&baud=115200
void handleRsBaud() {
  int port = server.arg("port").toInt();
  long baud = server.arg("baud").toInt();
  if (port < 1 || port > NUM_PORTS || baud < 1200 || baud > 921600) {
    server.send(400, "text/plain", "Cong (1..2) hoac baud (1200..921600) khong hop le");
    return;
  }
  rsBaud[port - 1] = baud;
  rs485Begin(port - 1);
  Serial.printf("RS485-%d: baud = %ld\n", port, baud);
  server.send(200, "text/plain", "Da dat baud " + String(baud) + " cho cong " + String(port));
}

// /rs485/clear?port=1
void handleRsClear() {
  int port = server.arg("port").toInt();
  if (port >= 1 && port <= NUM_PORTS) rxLog[port - 1] = "";
  server.send(200, "text/plain", "OK");
}

// /status -> JSON
void handleStatus() {
  String j;
  j.reserve(2600);
  j += "{\"up\":" + String(millis() / 1000);
  j += ",\"rssi\":" + String(WiFi.RSSI());

  j += ",\"adc\":[";
  for (int i = 0; i < NUM_ADC; i++) {
    if (i) j += ",";
    j += "{\"p\":" + String(ADC_PINS[i]) + ",\"mv\":" + String(analogReadMilliVolts(ADC_PINS[i])) + "}";
  }
  j += "],\"in\":[";
  for (int i = 0; i < NUM_IN; i++) {
    if (i) j += ",";
    j += "{\"p\":" + String(IN_PINS[i]) + ",\"v\":" + String(digitalRead(IN_PINS[i])) + "}";
  }
  j += "],\"out\":[";
  for (int i = 0; i < NUM_OUT; i++) {
    if (i) j += ",";
    j += "{\"p\":" + String(OUT_PINS[i]) + ",\"v\":" + String(digitalRead(OUT_PINS[i])) + "}";
  }
  j += "],\"rs\":[";
  for (int i = 0; i < NUM_PORTS; i++) {
    if (i) j += ",";
    j += "{\"tx\":" + String(TX_PIN[i]) + ",\"rx\":" + String(RX_PIN[i]);
    j += ",\"baud\":" + String(rsBaud[i]);
    j += ",\"rxn\":" + String(rxCount[i]) + ",\"txn\":" + String(txCount[i]);
    j += ",\"log\":\"" + jsonEscape(rxLog[i]) + "\"}";
  }
  j += "]}";
  server.send(200, "application/json", j);
}

// ======================= WIFI =======================
void connectWiFi(unsigned long timeoutMs) {
  Serial.printf("Dang ket noi WiFi \"%s\"", WIFI_SSID);
  WiFi.mode(WIFI_STA);
  WiFi.setAutoReconnect(true);
  WiFi.begin(WIFI_SSID, WIFI_PASS);
  unsigned long start = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - start < timeoutMs) {
    delay(500);
    Serial.print(".");
  }
  if (WiFi.status() == WL_CONNECTED) {
    wifiWasConnected = true;
    Serial.println("\nWiFi OK!");
    Serial.print("Mo trinh duyet: http://");
    Serial.println(WiFi.localIP());
  } else {
    Serial.println("\nChua ket noi duoc WiFi (se tu thu lai). Kiem tra ten/mat khau, song 2.4GHz.");
  }
}

// ======================= LỆNH SERIAL (UART0) =======================
void handleSerialCmd() {
  if (!Serial.available()) return;
  String line = Serial.readStringUntil('\n');
  line.trim();
  if (line.length() == 0) return;

  if (line.equalsIgnoreCase("info")) {
    Serial.printf("WiFi: %s  IP: %s  RSSI: %d dBm\n",
                  WiFi.status() == WL_CONNECTED ? "OK" : "chua ket noi",
                  WiFi.localIP().toString().c_str(), WiFi.RSSI());
    return;
  }

  // "1:hello" hoặc "1:d100,100" -> gửi RS485
  if (line.length() >= 2 && line.charAt(1) == ':') {
    int port = line.substring(0, 1).toInt();
    if (port >= 1 && port <= NUM_PORTS) rs485Send(port - 1, line.substring(2));
    else Serial.println("Loi: cong RS485 chi tu 1 den 2");
    return;
  }

  // "9,1" -> bật/tắt chân OUT
  int comma = line.indexOf(',');
  if (comma > 0) {
    int pin = line.substring(0, comma).toInt();
    int state = line.substring(comma + 1).toInt();
    if (isOutPin(pin)) {
      digitalWrite(pin, state ? HIGH : LOW);
      Serial.printf("OK: GPIO%d = %d\n", pin, state ? 1 : 0);
    } else {
      Serial.printf("Loi: GPIO%d khong thuoc nhom OUT\n", pin);
    }
    return;
  }
  Serial.println("Lenh khong hop le. Vi du: 1:hello | 1:d100,100 | 9,1 | info");
}

// ======================= SETUP / LOOP =======================
void setup() {
  Serial.begin(115200);                       // UART0 qua CH343
  delay(2000);
  Serial.println("\n===== ESP32-S3 FULL =====");

  for (int i = 0; i < NUM_IN; i++) pinMode(IN_PINS[i], INPUT_PULLUP);
  for (int i = 0; i < NUM_OUT; i++) {
    pinMode(OUT_PINS[i], OUTPUT);
    digitalWrite(OUT_PINS[i], LOW);
  }

  analogReadResolution(12);
  analogSetAttenuation(ADC_11db);             // đọc được khoảng 0 - 3.1V
  for (int i = 0; i < NUM_ADC; i++) pinMode(ADC_PINS[i], INPUT);

  for (int i = 0; i < NUM_PORTS; i++) {
    ports[i]->begin(rsBaud[i], MB_SERIAL_CFG, RX_PIN[i], TX_PIN[i]);
    Serial.printf("RS485-%d: UART%d TX=%d RX=%d @%lu\n", i + 1, i + 1, TX_PIN[i], RX_PIN[i], rsBaud[i]);
  }

  connectWiFi(20000);

  server.on("/", handleRoot);
  server.on("/set", handleSet);
  server.on("/status", handleStatus);
  server.on("/rs485/send", handleRsSend);
  server.on("/rs485/baud", handleRsBaud);
  server.on("/rs485/clear", handleRsClear);
  server.begin();
  Serial.println("Web server da chay. Go lenh: 1:hello | 1:d100,100 | 9,1 | info");
}
unsigned long start = 0;   // khai báo phía trên setup()
unsigned long t=0;
void loop() {
  server.handleClient();
  handleSerialCmd();

    if (digitalRead(38) == 0 && start == 0) start = millis();   // nhấn nút: ghi giờ bắt đầu
  if (start != 0){
     t = millis() - start;   // đã qua bao nhiêu ms

    if      (t < 500)  digitalWrite(9, HIGH);   // nháy 1: sáng
    else if (t < 1000)  digitalWrite(9, LOW);    //         tắt
    else if (t < 1500)  digitalWrite(9, HIGH);   // nháy 2: sáng
    else if (t < 2000)  digitalWrite(9, LOW);    //         tắt
    else if (t < 2500) digitalWrite(9, HIGH);   // nháy 3: sáng
    else if (t < 3000) digitalWrite(9, LOW);    //         tắt
    else if (t < 3500) digitalWrite(9, HIGH);   // nháy 4: sáng
    else if (t < 4000) digitalWrite(9, LOW);    //         tắt
    else if (t < 4500) digitalWrite(9, HIGH);   // nháy 5: sáng
    else if (t < 5000) digitalWrite(9, LOW);    //         tắt
    else if (t==5000)start = 0;                             // xong, cho phép nhấn lại
  }

  // Nhận dữ liệu từ các cổng RS485
  for (int i = 0; i < NUM_PORTS; i++) {
    if (ports[i]->available()) {
      String chunk = "";
      while (ports[i]->available()) chunk += (char)ports[i]->read();
      rxCount[i] += chunk.length();
      rxLog[i] += chunk;
      if (rxLog[i].length() > LOG_MAX) rxLog[i] = rxLog[i].substring(rxLog[i].length() - LOG_MAX);
      Serial.printf("[RS485-%d] RX: %s\n", i + 1, chunk.c_str());
    }
  }

  // Tự thử nối lại WiFi nếu mất
  if (WiFi.status() != WL_CONNECTED) {
    if (millis() - lastWifiTry > 15000) {
      lastWifiTry = millis();
      Serial.println("WiFi mat ket noi, dang thu lai...");
      WiFi.reconnect();
    }
  } else if (!wifiWasConnected) {
    wifiWasConnected = true;
    Serial.print("WiFi OK! http://");
    Serial.println(WiFi.localIP());
  }
}
