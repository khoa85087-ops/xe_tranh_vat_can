// ======================= HÀM PHỤ =======================
bool isOutPin(int pin) {
  for (int i = 0; i < NUM_OUT; i++) if (OUT_PINS[i] == pin) return true;
  return false;
}

String jsonEscape(const String& s) {
  String o;
  o.reserve(s.length() + 8);
  for (size_t i = 0; i < s.length(); i++) {
    char c = s[i];
    if (c == '"') o += "\\\"";
    else if (c == '\\') o += "\\\\";
    else if (c == '\n') o += "\\n";
    else if (c == '\r') { /* bỏ qua */ }
    else if ((uint8_t)c < 32 || (uint8_t)c > 126) o += '.';
    else o += c;
  }
  return o;
}

// ======================= MODBUS RTU =======================
uint16_t crc16(const uint8_t *buf, size_t len) {
  uint16_t crc = 0xFFFF;
  for (size_t i = 0; i < len; i++) {
    crc ^= buf[i];
    for (uint8_t j = 0; j < 8; j++)
      crc = (crc & 1) ? (crc >> 1) ^ 0xA001 : crc >> 1;
  }
  return crc;
}

String hexStr(const uint8_t *b, size_t n) {
  String s; char t[4];
  for (size_t i = 0; i < n; i++) { snprintf(t, sizeof(t), "%02X ", b[i]); s += t; }
  s.trim();
  return s;
}

size_t mbTransact(HardwareSerial &p, const uint8_t *tx, size_t txLen, uint8_t *rx, size_t rxMax) {
  while (p.available()) p.read();
  p.write(tx, txLen);
  p.flush();
  size_t n = 0;
  unsigned long t = millis();
  while (millis() - t < MB_FIRST_TO && n == 0) {
    if (p.available()) { rx[n++] = p.read(); t = millis(); }
  }
  while (n > 0 && millis() - t < MB_GAP_TO && n < rxMax) {
    if (p.available()) { rx[n++] = p.read(); t = millis(); }
  }
  return n;
}

// true = là lệnh Modbus (d100,100 | d120 | d120:5), log chứa kết quả
bool modbusCommand(HardwareSerial &p, String s, String &log) {
  s.trim(); s.toLowerCase();
  if (s.length() < 2 || s[0] != 'd' || !isDigit(s[1])) return false;

  uint8_t tx[8], rx[64];
  uint16_t addr, val = 0, count = 1;
  bool isWrite;
  int comma = s.indexOf(',');
  int colon = s.indexOf(':');

  if (comma > 0) {
    isWrite = true;
    addr = s.substring(1, comma).toInt() + D_OFFSET;
    val  = (uint16_t)s.substring(comma + 1).toInt();
  } else {
    isWrite = false;
    if (colon > 0) {
      addr  = s.substring(1, colon).toInt() + D_OFFSET;
      count = s.substring(colon + 1).toInt();
      if (count < 1 || count > 20) { log = "Loi: so thanh ghi 1..20\n"; return true; }
    } else {
      addr = s.substring(1).toInt() + D_OFFSET;
    }
  }

  uint16_t f = isWrite ? val : count;
  tx[0] = SLAVE_ID; tx[1] = isWrite ? 0x06 : 0x03;
  tx[2] = addr >> 8; tx[3] = addr & 0xFF;
  tx[4] = f >> 8;    tx[5] = f & 0xFF;
  uint16_t crc = crc16(tx, 6);
  tx[6] = crc & 0xFF; tx[7] = crc >> 8;

  log = "TX: " + hexStr(tx, 8) + "\n";
  size_t n = mbTransact(p, tx, 8, rx, sizeof(rx));
  if (n == 0) { log += "Khong co phan hoi (sai baud/parity/ID/day A-B?)\n"; return true; }
  log += "RX: " + hexStr(rx, n) + "\n";

  if (n < 5 || crc16(rx, n - 2) != (uint16_t)(rx[n - 2] | (rx[n - 1] << 8))) {
    log += "Loi: sai CRC hoac thieu byte\n"; return true;
  }
  if (rx[1] & 0x80) { log += "PLC bao loi, exception = " + String(rx[2]) + "\n"; return true; }

  if (isWrite) {
    log += "OK: D" + String(addr - D_OFFSET) + " = " + String(val) + "\n";
  } else {
    for (uint16_t i = 0; i < count; i++) {
      uint16_t v = (rx[3 + i * 2] << 8) | rx[4 + i * 2];
      log += "D" + String(addr - D_OFFSET + i) + " = " + String(v) + "\n";
    }
  }
  return true;
}

// Ghi val vào D<d>. Trả về true nếu PLC trả lời OK
bool mbWriteD(int port, uint16_t d, uint16_t val) {
  String log;
  modbusCommand(*ports[port], "d" + String(d) + "," + String(val), log);
  return log.indexOf("OK:") >= 0;
}

// Đọc D<d> vào biến val. Trả về true nếu đọc được
bool mbReadD(int port, uint16_t d, uint16_t &val) {
  uint8_t tx[8], rx[16];
  uint16_t addr = d + D_OFFSET;
  tx[0] = SLAVE_ID; tx[1] = 0x03;
  tx[2] = addr >> 8; tx[3] = addr & 0xFF;
  tx[4] = 0;         tx[5] = 1;
  uint16_t crc = crc16(tx, 6);
  tx[6] = crc & 0xFF; tx[7] = crc >> 8;

  size_t n = mbTransact(*ports[port], tx, 8, rx, sizeof(rx));
  if (n < 7) return false;
  if (crc16(rx, n - 2) != (uint16_t)(rx[n - 2] | (rx[n - 1] << 8))) return false;
  if (rx[1] & 0x80) return false;
  val = (rx[3] << 8) | rx[4];
  return true;
}

// ======================= RS485 =======================
void rs485Send(int idx, const String& msg) {
  String log;
  if (modbusCommand(*ports[idx], msg, log)) {      // lệnh dạng d100,100
    txCount[idx] += 8;
    rxLog[idx] += log;
    if (rxLog[idx].length() > LOG_MAX)
      rxLog[idx] = rxLog[idx].substring(rxLog[idx].length() - LOG_MAX);
    Serial.printf("[RS485-%d] MODBUS:\n%s", idx + 1, log.c_str());
    return;
  }
  ports[idx]->print(msg);                          // text thường như cũ
  ports[idx]->flush();
  txCount[idx] += msg.length();
  Serial.printf("[RS485-%d] TX: %s\n", idx + 1, msg.c_str());
}

void rs485Begin(int idx) {
  ports[idx]->end();
  ports[idx]->begin(rsBaud[idx], MB_SERIAL_CFG, RX_PIN[idx], TX_PIN[idx]);
}

// ======================= HANDLER WEB =======================
void handleRoot() {
